{{- /* Runs on `chezmoi init`. Answers are saved to ~/.config/chezmoi/chezmoi.toml;
       re-ask with `chezmoi init --prompt`. */ -}}
{{- $name     := promptStringOnce      . "name"     "Git name" -}}
{{- $email    := promptStringOnce      . "email"    "Git email" -}}
{{- $choices  := list -}}
{{- range (include ".chezmoidata/packages.toml" | fromToml).catalog }}{{ $choices = append $choices .name }}{{ end -}}
{{- $packages := promptMultichoiceOnce . "packages" "Packages" $choices $choices -}}

# Use this clone in place (`chezmoi init --source .`), so later commands find it.
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    name     = {{ $name  | quote }}
    email    = {{ $email | quote }}
    packages = {{ $packages | toToml }}
{{ if eq .chezmoi.os "windows" }}
# Bypass is scoped to chezmoi's own scripts, so they run even under a stricter
# machine/GPO execution policy.
[interpreters.ps1]
    command = "pwsh"
    args    = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass"]
{{- end }}
